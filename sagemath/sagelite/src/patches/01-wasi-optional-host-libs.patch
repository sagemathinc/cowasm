+class _EnvelopeSequence:
+    """
+    Callable, value-comparable storage for a finite envelope prefix.
+
+    ``Envelope`` used to turn list and tuple inputs into anonymous functions.
+    Two such functions compare by identity, even when their finite prefixes
+    are equal, which made otherwise equivalent envelopes compare unequal.
+    """
+    def __init__(self, values, constraints):
+        self.values = tuple(values)
+        self.constraints = constraints
