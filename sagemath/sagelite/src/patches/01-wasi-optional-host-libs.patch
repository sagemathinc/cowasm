--- a/src/sage/matrix/matrix_mod2_dense.pyx
+++ b/src/sage/matrix/matrix_mod2_dense.pyx
@@ -164,0 +165,52 @@
+
+class _DoublyLexicalPermutation:
+    """A small GAP-free permutation result for doubly lexical ordering."""
+
+    def __init__(self, values):
+        self._values = tuple(values)
+
+    def __call__(self, value):
+        return self._values[value - 1]
+
+    def __iter__(self):
+        return iter(self._values)
+
+    def __len__(self):
+        return len(self._values)
+
+    def __repr__(self):
+        cycles = self.cycle_tuples()
+        if not cycles:
+            return "()"
+        return "".join("({})".format(",".join(map(str, cycle)))
+                       for cycle in cycles)
+
+    def __eq__(self, other):
+        try:
+            return self.dict() == other.dict()
+        except AttributeError:
+            return False
+
+    def __hash__(self):
+        return hash(self._values)
+
+    def dict(self):
+        return dict(enumerate(self._values, start=1))
+
+    def cycle_tuples(self):
+        cycles = []
+        seen = set()
+        for start in range(1, len(self._values) + 1):
+            if start in seen:
+                continue
+            cycle = []
+            value = start
+            while value not in seen:
+                seen.add(value)
+                cycle.append(value)
+                value = self._values[value - 1]
+            if len(cycle) > 1:
+                cycles.append(tuple(cycle))
+        return cycles
+
+
