+    def frobenius_form(self, flag=0, var='x'):
+        """
+        Return the Frobenius form of an integer matrix.
+
+        This provides the same PARI-backed operation as integer dense matrices
+        when the generic dense implementation is used as a fallback.
+
+        EXAMPLES::
+
+            sage: from sage.matrix.matrix_generic_dense import Matrix_generic_dense
+            sage: A = Matrix_generic_dense(MatrixSpace(ZZ, 3), range(9))
+            sage: A.frobenius_form()
+            [ 0  0  0]
+            [ 1  0 18]
+            [ 0  1 12]
+            sage: A.frobenius_form(1)
+            [x^3 - 12*x^2 - 18*x]
+            sage: F, B = A.frobenius_form(2)
+            sage: A == B^(-1) * F * B
+            True
+        """
+        if not self.is_square():
+            raise ArithmeticError("frobenius matrix of non-square matrix not defined.")
+
+        from sage.rings.integer_ring import ZZ
+        if self.base_ring() is not ZZ:
+            raise NotImplementedError("generic Frobenius form is implemented only for integer matrices")
+
+        if flag == 1:
+            from sage.rings.polynomial.polynomial_ring_constructor import PolynomialRing
+            r = PolynomialRing(self.base_ring(), names=var)
+            rational_self = self.change_ring(self.base_ring().fraction_field())
+            return [r(f) for f in rational_self.rational_form(format='invariants')]
+
+        from sage.libs.pari.convert_sage import integer_matrix_frobenius
+        v = integer_matrix_frobenius(
+            self._entries, self._nrows, self._ncols, flag
+        )
+        if flag == 0:
+            return self.matrix_space()(v)
+        elif flag == 2:
+            from sage.matrix.matrix_space import MatrixSpace
+            from sage.rings.rational_field import QQ
+            F = MatrixSpace(QQ, self.nrows())(v[0])
+            B = MatrixSpace(QQ, self.nrows())(v[1])
+            return F, B
