+cpdef tuple integer_matrix_lll(list entries, long nrows, long ncols):
+    """
+    Return the PARI LLL transformation and rank for a Sage integer matrix.
+
+    The transformation entries are row-major.  PARI reduces column vectors,
+    so this bridge rotates Sage's row vectors counterclockwise before calling
+    ``qflll0(..., 4)`` and transposes PARI's kernel/image transformation on
+    return.
+
+    EXAMPLES::
+
+        sage: from sage.libs.pari.convert_sage import integer_matrix_lll
+        sage: entries, rank = integer_matrix_lll(
+        ....:     [ZZ(1), ZZ(2), ZZ(3), ZZ(2), ZZ(4), ZZ(6),
+        ....:      ZZ(7), ZZ(0), ZZ(1), ZZ(-1), ZZ(-2), ZZ(-3)], 4, 3
+        ....: )
+        sage: rank, len(entries)
+        (2, 16)
+    """
+    _validate_integer_matrix_entries(entries, nrows, ncols)
+    if nrows == 0 or ncols == 0:
+        raise ValueError("direct integer-matrix LLL conversion requires nonempty dimensions")
+
+    cdef list rotated = [entries[i * ncols + ncols - j - 1]
+                         for j in range(ncols) for i in range(nrows)]
+    cdef GEN result
+    cdef GEN kernel
+    cdef GEN image
+    cdef long kernel_dimension
+    cdef long matrix_rank
+    cdef long i, j
+    sig_on()
+    try:
+        result = qflll0(
+            _new_GEN_from_integer_matrix(rotated, ncols, nrows), 4
+        )
+        kernel = gel(result, 1)
+        image = gel(result, 2)
+        kernel_dimension = lg(kernel) - 1
+        matrix_rank = lg(image) - 1
+        return ([_sage_integer_or_rational(gcoeff(kernel, j + 1, i + 1))
+                 for i in range(kernel_dimension) for j in range(nrows)] +
+                [_sage_integer_or_rational(gcoeff(image, j + 1, i + 1))
+                 for i in range(matrix_rank) for j in range(nrows)],
+                matrix_rank)
+    finally:
+        sig_off()
+
+
