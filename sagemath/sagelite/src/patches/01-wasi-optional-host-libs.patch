+
+        def _xgcd_univariate_polynomial(self, f, g):
+            r"""
+            Return a scaled extended gcd of ``f`` and ``g``.
+
+            The extended Euclidean algorithm runs over the fraction field;
+            clearing the three result denominators then gives coefficients in
+            this unique factorization domain.  The gcd may be multiplied by a
+            divisor of the resultant, as for Sage's specialized integer-
+            polynomial implementations.
+
+            EXAMPLES::
+
+                sage: R.<x> = PolynomialRing(ZZ, implementation='generic')
+                sage: xgcd(2*x*(x - 1), x^2)
+                (2*x, -1, 2)
+                sage: d, u, v = xgcd(x + 2, x + 4)
+                sage: d == u*(x + 2) + v*(x + 4)
+                True
+            """
+            fraction_field = self.fraction_field()
+            fraction_polynomials = f.parent().base_extend(fraction_field)
+            d, u, v = fraction_field._xgcd_univariate_polynomial(
+                fraction_polynomials(f), fraction_polynomials(g)
+            )
+            denominator = d.denominator().lcm(u.denominator())
+            denominator = denominator.lcm(v.denominator())
+            polynomials = f.parent()
+            return tuple(polynomials(denominator * value)
+                         for value in (d, u, v))

