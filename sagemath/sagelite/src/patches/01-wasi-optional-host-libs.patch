+cpdef object integer_matrix_frobenius(list entries, long nrows, long ncols,
+                                      long flag=0):
+    """
+    Return the PARI Frobenius data for a row-major Sage integer matrix.
+
+    EXAMPLES::
+
+        sage: from sage.libs.pari.convert_sage import integer_matrix_frobenius
+        sage: integer_matrix_frobenius([ZZ(0), ZZ(1), ZZ(0), ZZ(0)], 2, 2)
+        [0, 0, 1, 0]
+    """
+    _validate_integer_matrix_entries(entries, nrows, ncols)
+    if flag not in (0, 2):
+        raise ValueError("direct integer-matrix Frobenius conversion supports flags 0 and 2")
+
+    cdef GEN result
+    sig_on()
+    try:
+        result = matfrobenius(
+            _new_GEN_from_integer_matrix(entries, nrows, ncols), flag, -1
+        )
+        if flag == 0:
+            return _sage_matrix_entries(result)
+        return (_sage_matrix_entries(gel(result, 1)),
+                _sage_matrix_entries(gel(result, 2)))
+    finally:
+        sig_off()
+
+
+cdef void _validate_integer_matrix_entries(list entries, long nrows,
+                                           long ncols) except *:
+    if nrows < 0 or ncols < 0 or len(entries) != nrows * ncols:
+        raise ValueError("matrix dimensions do not match the number of entries")
+    if not all(isinstance(entry, Integer) for entry in entries):
+        raise TypeError("matrix entries must be Sage integers")
+
+
+cdef GEN _new_GEN_from_integer_matrix(list entries, long nrows,
+                                      long ncols) noexcept:
+    cdef GEN matrix = zeromatcopy(nrows, ncols)
+    cdef long i, j
+    for i in range(nrows):
+        for j in range(ncols):
+            set_gcoeff(matrix, i + 1, j + 1,
+                       _new_local_GEN_from_integer(<Integer>entries[i * ncols + j]))
+    return matrix
+
+
+cdef inline GEN _new_local_GEN_from_integer(Integer value) noexcept:
+    if mpz_sgn(value.value) == 0:
+        return stoi(0)
+
+    cdef unsigned long limbs = mpz_size(value.value)
+    cdef GEN result = cgeti(limbs + 2)
+    result[1] = evalsigne(mpz_sgn(value.value)) + evallgefint(limbs + 2)
+    mpz_export(int_LSW(result), NULL, -1, sizeof(long), 0, 0, value.value)
+    return result
+
+
+cdef list _sage_matrix_entries(GEN matrix):
+    cdef long ncols = lg(matrix) - 1
+    cdef long nrows = 0 if ncols == 0 else lg(gel(matrix, 1)) - 1
+    cdef long i, j
+    return [_sage_integer_or_rational(gel(gel(matrix, j + 1), i + 1))
+            for i in range(nrows) for j in range(ncols)]
+
+
+cdef object _sage_integer_or_rational(GEN value):
+    cdef long value_type = typ(value)
+    cdef Integer integer_value
+    cdef Rational rational_value
+    if value_type == t_INT:
+        integer_value = <Integer>PY_NEW(Integer)
+        INT_to_mpz(integer_value.value, value)
+        return integer_value
+    if value_type == t_FRAC:
+        rational_value = <Rational>PY_NEW(Rational)
+        INTFRAC_to_mpq(rational_value.value, value)
+        return rational_value
+    raise TypeError("Frobenius matrix entry is not an integer or rational")
