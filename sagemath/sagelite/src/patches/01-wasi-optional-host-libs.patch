+    def _polynomial_(self, R):
+        """
+        Return ``self`` as an element of ``R``.
+
+        This conversion is defined when ``R`` is the underlying polynomial
+        ring and ``self`` contains no differential generators.
+
+        EXAMPLES::
+
+            sage: R.<x,y> = QQ[]
+            sage: W = R.weyl_algebra()
+            sage: x, y, dx, dy = W.gens()
+            sage: R(W(x^2 - y))
+            x^2 - y
+            sage: R(dx)
+            Traceback (most recent call last):
+            ...
+            TypeError: differential operator is not a polynomial
+        """
+        P = self.parent().polynomial_ring()
+        if R is not P:
+            raise TypeError(f"cannot convert a Weyl algebra element to {R}")
+
+        result = {}
+        for (x, dx), c in self:
+            if any(dx):
+                raise TypeError("differential operator is not a polynomial")
+            result[x] = c
+        return R(result)
