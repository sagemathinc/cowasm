+cpdef tuple integer_matrix_hnf(list entries, long nrows, long ncols,
+                               long flag=0, bint include_zero_rows=True):
+    """
+    Return the PARI Hermite form of a row-major Sage integer matrix.
+
+    The returned pair contains the row-major entries and number of rows of
+    the Sage-oriented result.
+
+    EXAMPLES::
+
+        sage: from sage.libs.pari.convert_sage import integer_matrix_hnf
+        sage: integer_matrix_hnf([ZZ(i) for i in range(1, 10)], 3, 3)
+        ([1, 2, 3, 0, 3, 6, 0, 0, 0], 3)
+        sage: integer_matrix_hnf([ZZ(i) for i in range(1, 10)], 3, 3,
+        ....:                    include_zero_rows=False)
+        ([1, 2, 3, 0, 3, 6], 2)
+    """
+    _validate_integer_matrix_entries(entries, nrows, ncols)
+    if flag not in (0, 1, 3, 4):
+        raise ValueError("direct integer-matrix HNF conversion supports flags 0, 1, 3, and 4")
+
+    # PARI computes a column HNF.  Rotate the Sage matrix counterclockwise,
+    # matching matrix_integer_dense._hnf_pari(), and rotate the result back.
+    cdef list rotated = [entries[i * ncols + ncols - j - 1]
+                         for j in range(ncols) for i in range(nrows)]
+    cdef GEN result
+    cdef long result_rows
+    cdef list result_entries
+    sig_on()
+    try:
+        result = mathnf0(
+            _new_GEN_from_integer_matrix(rotated, ncols, nrows), flag
+        )
+        if typ(result) == t_VEC:
+            result = gel(result, 1)
+        result_rows = lg(result) - 1
+        result_entries = [
+            _sage_integer_or_rational(
+                gcoeff(result, ncols - j, result_rows - i)
+            )
+            for i in range(result_rows) for j in range(ncols)
+        ]
+    finally:
+        sig_off()
+
+    if include_zero_rows:
+        result_entries.extend(
+            [Integer(0)] * ((nrows - result_rows) * ncols)
+        )
+        result_rows = nrows
+    return result_entries, result_rows
+
+
