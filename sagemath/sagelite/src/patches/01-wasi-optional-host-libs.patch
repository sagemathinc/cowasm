+class _MinimogMatrix:
+    def __init__(self, rows):
+        self._rows = rows
+
+    def __getitem__(self, key):
+        if isinstance(key, tuple):
+            i, j = key
+            return self._rows[i][j]
+        return self._rows[key]
+
+    def __repr__(self):
+        width = max(len(str(value)) for row in self._rows for value in row)
+        lines = []
+        for row in self._rows:
+            lines.append("[" + " ".join(str(value).rjust(width) for value in row) + "]")
+        return "\n".join(lines)
+
+    def _latex_(self):
+        rows = []
+        for row in self._rows:
+            rows.append(" & ".join("+\\infty" if value is infinity else str(value) for value in row))
+        return "\\left(\\begin{array}{rrrr}\n" + " \\\\\n".join(rows) + "\n\\end{array}\\right)"


