+            sage: CyclicPermutations([1, 2, 3, 3]).cardinality()
+            3
+            sage: CyclicPermutations([1, 1, 1]).cardinality()
+            1
+            sage: CyclicPermutations([]).cardinality()
+            0
+        """
+        content = [0] * len(self.mset)
+        for i in map(self.mset.index, self.mset):
