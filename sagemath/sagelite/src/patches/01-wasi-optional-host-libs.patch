+    def smith_form_gens(self):
+        """
+        Return Smith form generators with a canonical ambient lift.
+
+        For a torsion-free quotient, prefer the first ambient basis vector
+        whose image is primitive, then extend it to an integral basis.  This
+        makes the choice independent of the matrix backend's Smith
+        transformation.
+        """
+        try:
+            return self._toric_smith_form_gens
+        except AttributeError:
+            pass
+        generators = FGP_Module_class.smith_form_gens.f(self)
+        if generators and self.is_torsion_free():
+            from sage.matrix.constructor import matrix
+
+            generic = FGP_Module_class(self.V(), self.W())
+            for basis_element in self.V().gens():
+                coordinates = generic(basis_element).vector()
+                diagonal, left, right = matrix(ZZ, [coordinates]).smith_form()
+                if diagonal[0, 0].is_unit():
+                    change = right.inverse().change_ring(ZZ)
+                    change.rescale_row(0, left[0, 0])
+                    normalized = [self(basis_element)]
+                    zero = generators[0] * 0
+                    for row in change.rows()[1:]:
+                        normalized.append(sum(
+                            (coefficient * generator for coefficient, generator
+                             in zip(row, generators)), zero))
+                    generators = tuple(normalized)
+                    break
+        self._toric_smith_form_gens = generators
+        return generators
