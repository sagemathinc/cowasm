+class WeakReversePlanePartitions_shape(WeakReversePlanePartitions):
+    r"""
+    Weak reverse plane partitions of a fixed shape.
+    """
+    @staticmethod
+    def __classcall_private__(cls, shape):
+        """
+        Normalize ``shape`` to ensure a unique representation.
+
+        TESTS::
+
+            sage: S1 = WeakReversePlanePartitions([3, 1])
+            sage: S2 = WeakReversePlanePartitions((3, 1))
+            sage: S1 is S2
+            True
+        """
+        return super(WeakReversePlanePartitions, cls).__classcall__(cls, tuple(shape))
+
+    def __init__(self, shape):
+        """
+        Initialize ``self``.
+
+        TESTS::
+
+            sage: S = WeakReversePlanePartitions([3, 1])
+            sage: TestSuite(S).run()
+        """
+        from sage.combinat.partition import Partition
+        self.shape = Partition(shape)
+        WeakReversePlanePartitions.__init__(self)
+
+    def _repr_(self):
+        """
+        Return the string representation of ``self``.
+
+        EXAMPLES::
+
+            sage: WeakReversePlanePartitions([3, 1])
+            Weak Reverse Plane Partitions of shape [3, 1]
+        """
+        return "Weak Reverse Plane Partitions of shape {}".format(self.shape)
+
+    def __contains__(self, x):
+        """
+        Return whether ``x`` is a tableau of the prescribed shape.
+
+        EXAMPLES::
+
+            sage: S = WeakReversePlanePartitions([3, 1])
+            sage: [[0, 1, 2], [1]] in S
+            True
+            sage: [[0, 1], [1]] in S
+            False
+        """
+        return (WeakReversePlanePartitions.__contains__(self, x)
+                and [len(row) for row in x] == list(self.shape))
+
+    def _an_element_(self):
+        """
+        Return a weak reverse plane partition of the prescribed shape.
+
+        EXAMPLES::
+
+            sage: WeakReversePlanePartitions([3, 1]).an_element()
+            [[0, 0, 0], [0]]
+        """
+        return self.element_class(self, [[0] * length for length in self.shape])
