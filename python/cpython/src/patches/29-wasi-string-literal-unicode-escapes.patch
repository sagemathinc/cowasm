@@ -133,0 +134,13 @@
+static void
+cowasm_write_unicode_escape(char *p, Py_UCS4 ch)
+{
+    static const char hex[] = "0123456789abcdef";
+
+    p[0] = '\\';
+    p[1] = 'U';
+    for (int i = 9; i >= 2; i--) {
+        p[i] = hex[ch & 0xf];
+        ch >>= 4;
+    }
+}
+
